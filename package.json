    "ioredis": "^5.3.2",
    "patchright": "^1.58.2",
    "playwright": "^1.43.0",
    "ws": "^8.20.0",
    "zod": "^4.3.6"
  },
  "devDependencies": {
    "@types/cookie-parser": "^1.4.10",
    "@types/express": "^5.0.6",
    "@types/node": "^25.5.0",
    "@types/ws": "^8.18.1",
    "bun-types": "^1.3.11",
    "typescript": "^6.0.2"
