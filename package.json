{
  "name": "iframer-toolkit",
  "version": "0.10.5",
  "description": "Browser access toolkit for AI agents — CLI and MCP server for headless/headful browsing, login flows, and pipeline execution.",
  "keywords": [
    "iframer",
    "browser",
    "automation",
    "playwright",
    "patchright",
    "mcp",
    "ai-agents",
    "cli",
    "scraping"
  ],
  "homepage": "https://github.com/EduardoFazolo/iframer-toolkit#readme",
  "bugs": {
    "url": "https://github.com/EduardoFazolo/iframer-toolkit/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/EduardoFazolo/iframer-toolkit.git"
  },
  "license": "MIT",
  "author": "Eduardo Verona",
  "engines": {
    "node": ">=18"
  },
  "files": [
    "dist/",
    "skills/",
    "extension/",
    "README.md",
    "LICENSE"
  ],
  "bin": {
    "iframer": "dist/cli.js",
    "iframer-toolkit": "dist/cli.js"
  },
  "scripts": {
    "start": "bun run index.ts",
    "start:docker": "docker compose up --build -d",
    "stop:docker": "docker compose down",
    "logs:docker": "docker compose logs -f api",
    "test:smoke": "node tests/smoke.js",
    "mcp:install": "node bin/cli.js install-mcp",
    "mcp:remove": "node bin/cli.js remove-mcp",
    "build:stamp": "node scripts/stamp-extension-version.mjs",
    "build": "bun run build:stamp && node scripts/build.mjs",
    "test": "bun test tests/unit",
    "test:extension": "node tests/integration/extension-bridge.mjs",
    "prepublishOnly": "bun run build",
    "test:cdp-relay": "bun tests/integration/cdp-relay.mjs"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.80.0",
    "@modelcontextprotocol/sdk": "^1.29.0",
    "better-sqlite3": "^12.8.0",
    "fingerprint-generator": "^2.1.81",
    "patchright": "^1.58.2",
    "playwright-core": "^1.58.0",
    "ws": "^8.18.0",
    "zod": "^4.3.6"
  },
  "optionalDependencies": {
    "cloakbrowser": "^0.3.28"
  },
  "devDependencies": {
    "@types/better-sqlite3": "^7.6.13",
    "@types/express": "^5.0.6",
    "@types/node": "^25.5.0",
    "@types/ws": "^8.5.12",
    "bun-types": "^1.3.11",
    "esbuild": "0.28.2",
    "express": "^4.18.2",
    "tsx": "^4.23.12",
    "typescript": "^6.0.2"
  }
}
