# Redis connection (required)
REDIS_URL=redis://localhost:6379

# Server port (optional, defaults to 3021)
PORT=3021

# Optional secret — serves two purposes:
# 1. Auth: if set, all API requests must include x-api-key: <value>
# 2. Encryption: session data (cookies + localStorage) and stored credentials
#    are encrypted with this value before being written to Redis. Without it,
#    encryption falls back to the hardcoded string "iframer-local".
# Generate with: openssl rand -hex 32
IFRAMER_SECRET=

# Required for captcha solving (vision-based)
ANTHROPIC_API_KEY=
