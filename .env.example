# Server port when running from source with `bun run start` (optional, defaults to 3022)
PORT=3022

# Encryption key for sessions and stored credentials, and the extension pairing
# token (optional). Defaults to ~/.iframer/secret, generated on first install.
# Generate with: openssl rand -hex 32
IFRAMER_SECRET=

# Required for the solve-captcha step (best-effort, vision-based captcha solving)
ANTHROPIC_API_KEY=
